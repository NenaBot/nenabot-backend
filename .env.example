# nenabot environment configuration example
# Copy to .env and adjust values for your setup.

# -----------------------------------------------------------------------------
# Core application runtime (used by app/dependencies.py)
# -----------------------------------------------------------------------------

# IonVision HTTP base URL
IONVISION_BASE_URL=http://localhost:8080

# IonVision WebSocket base URL.
# If unset, it is derived from IONVISION_BASE_URL.
IONVISION_WS_BASE_URL=ws://localhost:8080/socket

# Enable full mock hardware mode for frontend/local development.
# 0 = real adapters, 1 = mock robot/camera/ionvision adapters.
NENABOT_MOCK_MODE=0

# Maximum number of jobs to retain.
# 0 or empty means unlimited. Must be a non-negative integer.
NENABOT_MAX_JOBS=1

# Default work Z coordinate (mm) for the default inspection profile.
# Negative values lower the arm below the calibration plane.
NENABOT_DEFAULT_WORK_Z=-35

# Default path population density (measuring points per cm)
# for the default inspection profile. Must be a positive float (> 0).
NENABOT_DEFAULT_MEASURING_POINTS_PER_CM=0.5



# # -----------------------------------------------------------------------------
# # Manual IonVision hardware integration tests (all optional)
# # tests/test_ionvision_hardware.py
# # -----------------------------------------------------------------------------

# # Optional: set to 1 to run IonVision hardware tests (default in tests: 0)
# IONVISION_RUN_HARDWARE_TESTS=0

# # Optional: request timeout in seconds (default in tests: 10.0)
# IONVISION_REQUEST_TIMEOUT_S=10.0

# # Optional: allow mutation tests (default in tests: true)
# IONVISION_ENABLE_MUTATION_TESTS=1

# # Optional: run websocket tests (default in tests: true)
# IONVISION_RUN_WS_TEST=1

# # Optional: timeout for websocket event assertions (default in tests: 10.0)
# IONVISION_WS_EVENT_TIMEOUT_S=10.0

# # Optional: timeout for scan.resultsProcessed event (default in tests: 120.0)
# IONVISION_SCAN_RESULTS_PROCESSED_TIMEOUT_S=120.0

# # Optional: /results query tuning values (defaults from tests)
# IONVISION_RESULTS_MAX_RESULTS=100
# IONVISION_RESULTS_PAGE=
# IONVISION_RESULTS_SEARCH=
# IONVISION_RESULTS_START_DATE=2026-03-17T13:01:11.874Z
# IONVISION_RESULTS_END_DATE=2026-03-25T13:01:11.874Z
# IONVISION_RESULTS_SORT_BY=date_dsc
# IONVISION_RESULTS_ONLY_METADATA=1
# IONVISION_RESULTS_IDS=


# # -----------------------------------------------------------------------------
# # Manual Robot hardware integration tests (all optional)
# # tests/test_robot_hardware.py
# # -----------------------------------------------------------------------------

# # Optional: set to 1 to run live robot hardware tests (default in tests: 0)
# RUN_ROBOT_HARDWARE_TESTS=0

# # Optional: enable legacy homing call in RobotAdapter (default: 0)
# DOBOT_ENABLE_LEGACY_HOMING=0

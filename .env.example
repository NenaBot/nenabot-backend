# HTTP base URL of the IonVision DMS device
# IONVISION_BASE_URL=http://192.168.1.100:8080
# NENABOT_DMS_BASE_URL=http://192.168.1.100:8080

# WebSocket base URL of the IonVision DMS device (derived from HTTP URL if unset)
# IONVISION_WS_BASE_URL=ws://192.168.1.100:8080
# NENABOT_DMS_WS_BASE_URL=ws://192.168.1.100:8080

# Maximum number of jobs to retain (0 = unlimited).
# When set, the oldest jobs beyond this limit are deleted after each job run.
# NENABOT_MAX_JOBS=10

# Default work Z coordinate (mm) for the default inspection profile.
# Pre-filled in the job tester UI on page load.
# Negative values lower the arm below the calibration plane.
NENABOT_DEFAULT_WORK_Z=-35

# Default path population density (measuring points per cm)
# for the default inspection profile.
# Pre-filled in the job tester UI on page load.
# Must be a positive float (> 0).
NENABOT_DEFAULT_MEASURING_POINTS_PER_CM=0.5
